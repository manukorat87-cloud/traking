/* ===== NEW: LAYOUT WRAPPER ===== */
.co-body {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-height: 0; /* critical: allow flex child to shrink below content size */
  overflow: hidden;
}

/* ===== UTILITY ===== */
.co-grey-text { color: #737373; font-size: 12px; }
.co-currency { font-size: 12px; color: #737373; margin-right: 4px; font-weight: 400; }

/* ===== MOBILE TOP HEADER BAR ===== */
.co-mobile-header {
