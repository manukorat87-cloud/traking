.co-footer-link:hover { text-decoration: underline; }

/* ===== DESKTOP: hide mobile-only elements ===== */
.co-mobile-pay-btn { display: none; }

/* ===== MOBILE OVERRIDES ===== */
@media(max-width: 768px) {
  /* Show mobile header */
  .co-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid #e1e1e1;
