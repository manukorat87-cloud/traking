  function fetchCartAndRender() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        renderSummaryItems(cart.items);
        updateTotals(cart.total_price);
      })
      .catch(error => console.error('Error fetching cart:', error));
  }

  function buildItemsHTML(items) {
    return items.map(item => {
      const price = (item.price || item.final_price) / 100;
      const imgSrc = item.image || (item.featured_image && item.featured_image.url) || '';
      return `
        <div class="order-summary-item">
          <div class="order-summary-image">
            <img src="${imgSrc}" alt="${item.title}">
            <span class="order-summary-qty">${item.quantity}</span>
          </div>
          <div class="order-summary-details">
            <h3 class="order-summary-title">${item.product_title || item.title}</h3>
            ${item.variant_title && item.variant_title !== 'Default Title' ? `<div class="order-summary-variant">${item.variant_title}</div>` : ''}
          </div>
          <div class="order-summary-price">₹${price.toFixed(2)}</div>
        </div>
      `;
    }).join('');
  }

  function renderSummaryItems(items) {
    window.currentCheckoutItems = items;
    const html = buildItemsHTML(items);
    const desktopContainer = document.getElementById('checkout-order-summary-items');
    if (desktopContainer) desktopContainer.innerHTML = html;
    const mobileContainer = document.getElementById('checkout-order-summary-items-mobile');
    if (mobileContainer) mobileContainer.innerHTML = html;
  }

  function updateTotals(totalInCents) {
    const total = totalInCents / 100;
    const formatted = '₹' + total.toFixed(2);
    // Desktop
    document.getElementById('checkout-subtotal').innerText = formatted;
    document.getElementById('checkout-total').innerText = formatted;
    // Mobile
    const mobileSubtotal = document.getElementById('checkout-subtotal-mobile');
    const mobileTotal = document.getElementById('checkout-total-mobile');
    const mobileTopTotal = document.getElementById('co-mobile-total');
    const mobileStickyTotal = document.getElementById('co-sticky-total');
    if (mobileSubtotal) mobileSubtotal.innerText = formatted;
    if (mobileTotal) mobileTotal.innerText = formatted;
    if (mobileTopTotal) mobileTopTotal.innerText = formatted;
    if (mobileStickyTotal) mobileStickyTotal.innerText = formatted;
    window.checkoutTotalAmount = total;
  }
});


/* =====================================================
   GLOBAL CHECKOUT INTERCEPTOR — 5 LAYERS
   Catches EVERY path to Shopify's /checkout and opens
   the custom checkout popup instead.
   ===================================================== */
(function() {

  function openPopupOrFallback() {
    if (typeof window.openCustomCheckout === 'function') {
      window.openCustomCheckout(false);
    }
  }

  /* Layer 1: Anchor link clicks to /checkout */
  document.addEventListener('click', function(e) {
    var el = e.target;
    while (el && el.tagName !== 'A') { el = el.parentElement; }
    if (!el) return;
    var href = el.getAttribute('href') || '';
    if (/\/checkout/.test(href) && href.indexOf('superprofile') === -1) {
      e.preventDefault(); e.stopPropagation(); openPopupOrFallback();
    }
  }, true);

  /* Layer 2: button[name=checkout] clicks */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('button[name="checkout"], input[name="checkout"]');
    if (btn) { e.preventDefault(); e.stopPropagation(); openPopupOrFallback(); }
  }, true);

  /* Layer 3: Form submit (cart forms with checkout field) */
  document.addEventListener('submit', function(e) {
    var form = e.target;
    var action = form.getAttribute('action') || '';
    var hasCheckout = form.querySelector('[name="checkout"]');
    if (/\/checkout/.test(action) || hasCheckout) {
      e.preventDefault(); e.stopPropagation(); openPopupOrFallback();
    }
  }, true);

  /* Layer 4: window.location.href = '/checkout' */
  try {
    var _hrefD = Object.getOwnPropertyDescriptor(Location.prototype, 'href');
    if (_hrefD && _hrefD.set) {
      var _origSet = _hrefD.set;
      Object.defineProperty(Location.prototype, 'href', {
        set: function(url) {
          if (typeof url === 'string' && /\/checkout/.test(url) && url.indexOf('superprofile') === -1) {
            openPopupOrFallback(); return;
          }
          _origSet.call(this, url);
        },
        get: _hrefD.get,
        configurable: true
      });
    }
  } catch(e2) {}

  /* Layer 5: location.assign('/checkout') */
  try {
    var _origAssign = Location.prototype.assign;
    Location.prototype.assign = function(url) {
      if (typeof url === 'string' && /\/checkout/.test(url) && url.indexOf('superprofile') === -1) {
        openPopupOrFallback(); return;
      }
      _origAssign.call(this, url);
    };
  } catch(e2) {}

})();
