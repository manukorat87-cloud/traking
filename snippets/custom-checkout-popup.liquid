  .checkout-right-col {
    display: none !important;
  }

  /* Desktop pay button hidden on mobile */
  .co-desktop-btn {
    display: none !important;
  }

  /* Show mobile sticky pay bar */
  .co-mobile-pay-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    padding-bottom: max(14px, env(safe-area-inset-bottom));
    background: #fff;
    border-top: 1px solid #e1e1e1;
    flex-shrink: 0;
    z-index: 20;
    gap: 12px;
    box-sizing: border-box;
  }
  .co-mobile-pay-total {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .co-pay-label {
    font-size: 11px;
    color: #737373;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .co-pay-amount {
    font-size: 16px;
