<script>
document.addEventListener('DOMContentLoaded', function() {
  const popup = document.getElementById('custom-checkout-popup');
  const form = document.getElementById('custom-checkout-form');
  const closeBtn = document.getElementById('custom-checkout-close');
  
  if (closeBtn && popup) {
    closeBtn.addEventListener('click', function() {
      popup.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  }
  
  // Expose function globally to open popup
  window.openCustomCheckout = function(isBuyItNow = false, productData = null) {
    if (popup) {
      popup.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      
      if (isBuyItNow && productData) {
        renderSummaryItems([productData]);
        updateTotals(productData.price * productData.quantity);
      } else {
        fetchCartAndRender();
      }
    }
  };

  // Global event delegation for "Buy it now" buttons
  document.addEventListener('click', function(e) {
    const buyBtn = e.target.closest('.custom-buy-it-now');
    if (buyBtn) {
      e.preventDefault();
      const form = buyBtn.closest('form');
      const qtyInput = form ? form.querySelector('[name="quantity"]') : null;
      const qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
      
      const productData = {
        title: buyBtn.getAttribute('data-product-title'),
        image: buyBtn.getAttribute('data-product-image'),
        price: parseInt(buyBtn.getAttribute('data-product-price'), 10),
        quantity: qty
      };
      
      window.openCustomCheckout(true, productData);
    }
  });

  // Mobile: Order summary toggle
  const summaryToggle = document.getElementById('co-summary-toggle');
  const mobileSummary = document.getElementById('co-mobile-summary');
  if (summaryToggle && mobileSummary) {
    summaryToggle.addEventListener('click', function() {
      const isOpen = mobileSummary.style.display !== 'none';
      mobileSummary.style.display = isOpen ? 'none' : 'block';
      summaryToggle.querySelector('.co-toggle-arrow').classList.toggle('open', !isOpen);
    });
  }

  // Handle form submission
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalBtnText = submitBtn.innerText;
    submitBtn.innerText = 'Processing...';
    submitBtn.disabled = true;
    
    // Get form data
    const formData = new FormData(form);
    const rawCustomerData = Object.fromEntries(formData.entries());
    
    // Sanitize customer data strings to prevent broken JSON in Make.com / MongoDB string substitution
    const customerData = {};
    for (const key in rawCustomerData) {
      if (typeof rawCustomerData[key] === 'string') {
        customerData[key] = rawCustomerData[key]
          .replace(/"/g, "'")       // Replace double quotes with single quotes
          .replace(/[\r\n]+/g, " ") // Replace newlines with spaces
          .replace(/\\/g, "/")      // Replace backslashes
          .trim();
      } else {
        customerData[key] = rawCustomerData[key];
      }
    }
    
    // Sanitize item details
    const sanitizedItems = (window.currentCheckoutItems || []).map(item => {
      const cleanItem = { ...item };
      for (const key in cleanItem) {
        if (typeof cleanItem[key] === 'string') {
          cleanItem[key] = cleanItem[key].replace(/"/g, "'").replace(/[\r\n]+/g, " ");
        }
      }
      return cleanItem;
    });

    const totalAmountString = document.getElementById('checkout-total').innerText.replace(/[^\d.-]/g, '');
    const totalAmount = parseFloat(totalAmountString);
    const orderTime = new Date().toISOString();

    // 1. Post to Make.com Webhook (which saves to MongoDB)
    const webhookUrl = "https://hook.eu1.make.com/oatvmbsmfmg1as55b8b3wyngp3sn65ny";
    
    fetch(webhookUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      keepalive: true,
      body: JSON.stringify({ 
        customer: customerData, 
        items: sanitizedItems,
        total: totalAmount,
        orderTime: orderTime
      })
    })
    .then(res => {
      // 2. Redirect to Payment Link based on amount
      const paymentLinks = {
        1999: "https://superprofile.bio/vp/0drx-A4v",
        2499: "https://superprofile.bio/vp/uzH9QW8j",
        2699: "https://superprofile.bio/vp/piNH5eXN",
        2799: "https://superprofile.bio/vp/PUKPpiJn",
        3998: "https://superprofile.bio/vp/r-J51OXV",
        4498: "https://superprofile.bio/vp/6eMUrEME",
        4698: "https://superprofile.bio/vp/uCMXkQa_",
        4798: "https://superprofile.bio/vp/3Ts95WR8",
        4998: "https://superprofile.bio/vp/qyTk8PW_",
        5198: "https://superprofile.bio/vp/h0IhEwX4",
        5298: "https://superprofile.bio/vp/nk18MCoD",
        5398: "https://superprofile.bio/vp/MyKNCgR4",
        5498: "https://superprofile.bio/vp/bKNmzqo0",
        5598: "https://superprofile.bio/vp/ksrO30B4",
        5997: "https://superprofile.bio/vp/WTMqVBiF",
