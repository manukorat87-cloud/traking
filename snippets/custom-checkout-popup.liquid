  /* Left col adjustments on mobile */
  .checkout-left-col {
    max-width: 100%;
    padding: 20px 20px 20px;
  }
  .checkout-store-name {
    display: none; /* shown in mobile header instead */
  }
  .co-footer-links {
    margin-top: 20px;
    padding-bottom: 20px;
  }
}
</style>

